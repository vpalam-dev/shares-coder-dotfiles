{
  "keybindings": [
    { "key": "F7", "modifiers": [], "action": "open_live_grep", "when": "normal" },
    { "key": "F7", "modifiers": ["shift"], "action": "resume_live_grep", "when": "normal" },
    { "key": "F6", "modifiers": [], "action": "lsp_hover", "when": "normal" },
    { "key": "F4", "modifiers": [], "action": "lsp_code_actions", "when": "normal" },
    { "key": "F9", "modifiers": [], "action": "navigate_back", "when": "normal" },
    { "key": "F9", "modifiers": ["shift"], "action": "navigate_forward", "when": "normal" },
    { "key": "w", "modifiers": ["ctrl"], "action": "close_tab", "when": "normal" },
    { "key": "F5", "modifiers": [], "action": "open_terminal_in_dock", "when": "normal" }
  ]
}
